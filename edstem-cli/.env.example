# EdStem API Configuration
# Get your API token:
#   - Australia / Global (UTS, USYD, UNSW, etc.): https://edstem.org/settings/api-tokens
#   - US: https://edstem.org/us/settings/api-tokens
ED_API_TOKEN=your_token_here

# Optional: Override base API URL (defaults to https://edstem.org/api/)
# ED_BASE_URL=https://edstem.org/api/
# For US accounts:
# ED_BASE_URL=https://us.edstem.org/api/
