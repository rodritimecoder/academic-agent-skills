{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sift report (sift_report.json)",
  "description": "Classifier triage decisions and confidence written by Stage 2.",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "decisions", "confidence", "route"],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "decisions": {
            "type": "object"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "route": {
            "type": "string",
            "enum": ["keep", "review", "drop"]
          }
        }
      }
    }
  }
}
